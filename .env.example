# concept-book environment configuration
#
# Copy this file to .env and edit the values for your setup:
#   cp .env.example .env
#
# All keys use the CB_ prefix. The .env file is gitignored — never commit it.

# ── Ports ────────────────────────────────────────────────────────────────────
# Backend API port — read by start-api.sh and vite.config.js proxy
API_PORT=8211

# Frontend dev server port — read by vite.config.js (server.port)
DEV_PORT=8311

# ── FastAPI / OAuth ───────────────────────────────────────────────────────────
# Google OAuth (CB_GOOGLE_*) — unset → button hidden, endpoints 503
CB_GOOGLE_CLIENT_ID=
CB_GOOGLE_CLIENT_SECRET=

# OAuth callback sent to the backend; must be an authorized redirect URI in
# the Google Cloud Console. Default matches the API_PORT above.
CB_GOOGLE_REDIRECT_URI=http://localhost:8200/api/auth/google/callback

# Where the backend redirects the browser after OAuth completes.
# Must match DEV_PORT above.
CB_FRONTEND_URL=http://localhost:5173/concept-book-base/

# Signs the OAuth state cookie. Unset → random per boot (fine for dev).
CB_SESSION_SECRET=

# ── Content pipeline ───────────────────────────────────────────────────────────

# Absolute path to your local SPL.py repo clone.
# Used by scripts/sync_from_spl.sh to pull graph.yaml files.
CB_SPL_DIR=~/projects/digital-duck/SPL.py

# Path to the public/domains directory (relative to repo root or absolute).
# Generated concept_*.html and book_*.html files live here.
CB_PUBLIC_DOMAINS=./public/domains

# ── LLM backend ────────────────────────────────────────────────────────────────

# LLM used by the /api/generate endpoint (spl3 run build_concept_book.spl).
# Format: <adapter>:<model-id>
#
# Claude CLI (default):
CB_LLM=claude_cli:claude-sonnet-4-6
#
# Ollama (local):
# CB_LLM=ollama:gemma3
#
# OpenRouter:
# CB_LLM=openrouter:anthropic/claude-sonnet-4-6

# Default model shown in the BookPage Pane A / Pane B picker.
# Must match one of the model subfolder names under output/{level}.{lang}/
CB_DEFAULT_MODEL=gemma4

# ── SPL execution limits ────────────────────────────────────────────────────────

# Passed through to the spl3 subprocess as SPL_WHILE_MAX_ITER / SPL_MAX_LLM_CALLS
# (both the /api/generate backend and scripts/batch_generate.py apply these the
# same way — see api/services/executor.py, api/config.py). SPL.py's own default
# with neither var set is a much tighter 15 iterations, which some longer
# capstone-application sections (e.g. linear programming, determinant-by-row-
# reduction write-ups) can exceed even when the section is converging fine, just
# slowly. If a generation fails with "WHILE loop exceeded N iterations", the
# executor now auto-extends the cap by 50% once and retries in place before
# failing for real (see SPL.py's spl/executor.py) — these settings raise the
# starting cap so that's rarely needed at all.
CB_SPL_WHILE_MAX_ITER=50
CB_SPL_MAX_LLM_CALLS=50

# ── Compare cache ──────────────────────────────────────────────────────────────

# How long a cached /api/compare result is reused before expiring (seconds).
# 0 = never expire.  Override on the Settings page at runtime.
#   86400  = 1 day  (default)
#   604800 = 1 week
#   0      = never expire
CB_COMPARE_CACHE_TTL=86400
